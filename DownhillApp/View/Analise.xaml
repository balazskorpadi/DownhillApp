<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="DownhillApp.View.Analise"
             Title="Analise">
    <ScrollView>
        <VerticalStackLayout>
            <Button Text="Back to Menu" Command="{Binding C_BackToMenu}" Margin="10"/>
            <Label Text="This is the best ride in this Group" FontSize="Medium" HorizontalOptions="Center" Margin="10,30,10,0"/>
            <Border Stroke="Purple" StrokeThickness="5" Margin="10">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*">
                    <Label Margin="10" Grid.Column="0" HorizontalTextAlignment="Center" Text="Name"/>
                    <Label Margin="10" Grid.Column="1" HorizontalTextAlignment="Center" Text="Time"/>
                    <Label Margin="10" Grid.Column="2" HorizontalTextAlignment="Center" Text="Groupname"/>
                    <Label Margin="10" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding BestRide.Name}"/>
                    <Label Margin="10" Grid.Column="1" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding BestRide.Time}"/>
                    <Label Margin="10" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding BestRide.GroupName}"/>
                </Grid>
            </Border>
            <Label Text="Analiseing selected ride" FontSize="Medium" HorizontalOptions="Center" Margin="10,30,10,0"/>
            <Border Stroke="Purple" StrokeThickness="5" Margin="10">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*">
                    <Label Margin="10" Grid.Column="0" HorizontalTextAlignment="Center" Text="Name"/>
                    <Label Margin="10" Grid.Column="1" HorizontalTextAlignment="Center" Text="Time"/>
                    <Label Margin="10" Grid.Column="2" HorizontalTextAlignment="Center" Text="Groupname"/>
                    <Label Margin="10" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding SelectedRide.Name}"/>
                    <Label Margin="10" Grid.Column="1" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding SelectedRide.Time}"/>
                    <Label Margin="10" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding SelectedRide.GroupName}"/>
                </Grid>
            </Border>

            <chart:SfCartesianChart Margin="10" Background="black">
                <chart:SfCartesianChart.Title>
                    <Label Text="Gyorsulás Z irányban" HorizontalOptions="Center" FontSize="Medium"/>
                </chart:SfCartesianChart.Title>

                <chart:SfCartesianChart.XAxes>
                    <chart:NumericalAxis Interval="0.5">
                        <chart:NumericalAxis.Title>
                            <chart:ChartAxisTitle Text="Idő (sec)" TextColor="Purple" FontSize="20"/>
                        </chart:NumericalAxis.Title>
                        <chart:NumericalAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle TextColor="White" FontSize="10"/>
                        </chart:NumericalAxis.LabelStyle>
                    </chart:NumericalAxis>
                </chart:SfCartesianChart.XAxes>

                <chart:SfCartesianChart.YAxes>
                    <chart:NumericalAxis Interval="0.125">
                        <chart:NumericalAxis.Title>
                            <chart:ChartAxisTitle Text="Gyorsulás (m/s^2)" TextColor="Purple" FontSize="20"/>
                        </chart:NumericalAxis.Title>
                        <chart:NumericalAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle TextColor="White" FontSize="10"/>
                        </chart:NumericalAxis.LabelStyle>
                    </chart:NumericalAxis>
                </chart:SfCartesianChart.YAxes>

                <chart:SplineSeries ShowMarkers="True" StrokeWidth="4" ItemsSource="{Binding DataSelectedZ}" XBindingPath="X" YBindingPath="Y">
                    <chart:SplineSeries.Trendlines>
                        <chart:ExponentialTrendline IsVisible="False" StrokeWidth="5"/>
                    </chart:SplineSeries.Trendlines>
                </chart:SplineSeries>
            </chart:SfCartesianChart>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>