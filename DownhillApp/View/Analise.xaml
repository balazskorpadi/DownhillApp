<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:chart="clr-namespace:Syncfusion.Maui.Charts;assembly=Syncfusion.Maui.Charts"
             x:Class="DownhillApp.View.Analise"
             Title="Analyse">
    <ScrollView>
        <VerticalStackLayout>
            
            <Label Text="This is the best ride in this Group" FontSize="Medium" HorizontalOptions="Center" Margin="10,30,10,0"/>
            <Border Stroke="Purple" StrokeThickness="5" Margin="10">
                <Grid ColumnDefinitions="*,*,*" RowDefinitions="*,*">
                    <Label Margin="10" Grid.Column="0" HorizontalTextAlignment="Center" Text="Name"/>
                    <Label Margin="10" Grid.Column="1" HorizontalTextAlignment="Center" Text="Time"/>
                    <Label Margin="10" Grid.Column="2" HorizontalTextAlignment="Center" Text="Groupname"/>
                    <Label Margin="10" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding BestRide.Name}"/>
                    <Label Margin="10" Grid.Column="1" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding BestRide.Time, StringFormat='{0} sec'}"/>
                    <Label Margin="10" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding BestRide.GroupName}"/>
                </Grid>
            </Border>
            <Label Text="Selected ride" FontSize="Medium" HorizontalOptions="Center" Margin="10,30,10,0"/>
            <Border Stroke="Purple" StrokeThickness="5" Margin="10">
                <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="*,*">
                    <Label Margin="10" Grid.Column="0" HorizontalTextAlignment="Center" Text="Name"/>
                    <Label Margin="10" Grid.Column="1" HorizontalTextAlignment="Center" Text="Time"/>
                    <Label Margin="10" Grid.Column="2" HorizontalTextAlignment="Center" Text="Distance"/>
                    <Label Margin="10" Grid.Column="3" HorizontalTextAlignment="Center" Text="Groupname"/>
                    <Label Margin="10" Grid.Column="0" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding SelectedRide.Name}"/>
                    <Label Margin="10" Grid.Column="1" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding SelectedRide.Time, StringFormat='{0} sec'}"/>
                    <Label Margin="10" Grid.Column="2" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding MaxDistance, StringFormat='{0:F2} m'}"/>
                    <Label Margin="10" Grid.Column="3" Grid.Row="1" HorizontalTextAlignment="Center" Text="{Binding SelectedRide.GroupName}"/>
                </Grid>
            </Border>

            <chart:SfCartesianChart Margin="10" Background="black">
                <chart:SfCartesianChart.Title>
                    <Label Text="Acceleration" HorizontalOptions="Center" FontSize="Medium"/>
                </chart:SfCartesianChart.Title>

                <chart:SfCartesianChart.XAxes>
                    <chart:NumericalAxis Interval="2.5">
                        <chart:NumericalAxis.Title>
                            <chart:ChartAxisTitle Text="Distance (m)" TextColor="Purple" FontSize="20"/>
                        </chart:NumericalAxis.Title>
                        <chart:NumericalAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle TextColor="White" FontSize="10"/>
                        </chart:NumericalAxis.LabelStyle>
                    </chart:NumericalAxis>
                </chart:SfCartesianChart.XAxes>

                <chart:SfCartesianChart.YAxes>
                    <chart:NumericalAxis Interval="2">
                        <chart:NumericalAxis.Title>
                            <chart:ChartAxisTitle Text="Acceleration (m/s^2)" TextColor="Purple" FontSize="20"/>
                        </chart:NumericalAxis.Title>
                        <chart:NumericalAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle TextColor="White" FontSize="10"/>
                        </chart:NumericalAxis.LabelStyle>
                    </chart:NumericalAxis>
                </chart:SfCartesianChart.YAxes>

                <chart:SplineSeries Label="Acceleration X" Fill="Red" ShowMarkers="True" StrokeWidth="4" ItemsSource="{Binding DataSelected}" XBindingPath="AxisX" YBindingPath="DataX"/>
                <chart:SplineSeries Label="Acceleration Y" Fill="Gold" ShowMarkers="True" StrokeWidth="4" ItemsSource="{Binding DataSelected}" XBindingPath="AxisX" YBindingPath="DataY"/>
                <chart:SplineSeries Label="Acceleration Z" Fill="Green" ShowMarkers="True" StrokeWidth="4" ItemsSource="{Binding DataSelected}" XBindingPath="AxisX" YBindingPath="DataZ"/>
                <chart:SfCartesianChart.Legend>
                    <chart:ChartLegend>
                        <chart:ChartLegend.LabelStyle>
                            <chart:ChartLegendLabelStyle TextColor="White"/>
                        </chart:ChartLegend.LabelStyle>
                    </chart:ChartLegend>
                </chart:SfCartesianChart.Legend>
            </chart:SfCartesianChart>



            <chart:SfCartesianChart Margin="10" Background="Black">
                <chart:SfCartesianChart.Resources>
                    <DataTemplate x:Key="ball">
                        
                            <Grid BackgroundColor="Yellow" RowDefinitions="auto, auto" ColumnDefinitions="auto, auto">
                                <Label Margin="2" TextColor="Black" Text="Height: "/>
                                <Label Margin="2" TextColor="Black" Grid.Column="1" Text="{Binding DataItem.Height, StringFormat='{0:F2} m'}"/>
                                <Label Margin="2" TextColor="Black" Grid.Row="1" Text="Grade: "/>
                            <Label Margin="2" TextColor="Black" Grid.Row="1" Grid.Column="1" Text="{Binding DataItem.Grade, StringFormat='{0:F2} %'}"/>
                            </Grid>
                        
                    </DataTemplate>
                </chart:SfCartesianChart.Resources>


                <chart:SfCartesianChart.Title>
                    <Label Text="Height Profile" HorizontalOptions="Center" FontSize="Medium"/>
                </chart:SfCartesianChart.Title>

                <chart:SfCartesianChart.XAxes>
                    <chart:NumericalAxis PlotOffsetStart="10" PlotOffsetEnd="10" ShowMajorGridLines="True" ShowMinorGridLines="False" Interval="5" MinorTicksPerInterval="4">
                        <chart:NumericalAxis.Title>
                            <chart:ChartAxisTitle Text="Distance (m)" TextColor="purple" FontSize="20"/>
                        </chart:NumericalAxis.Title>
                        <chart:NumericalAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle TextColor="White" FontSize="10"/>
                        </chart:NumericalAxis.LabelStyle>
                    </chart:NumericalAxis>
                </chart:SfCartesianChart.XAxes>

                <chart:SfCartesianChart.YAxes>
                    <chart:NumericalAxis PlotOffsetEnd="10" ShowMajorGridLines="True" ShowMinorGridLines="False" Interval="10" Minimum="{Binding MinHeight}">
                        <chart:NumericalAxis.Title>
                            <chart:ChartAxisTitle Text="Amplitude (m)" TextColor="purple" FontSize="20"/>
                        </chart:NumericalAxis.Title>
                        <chart:NumericalAxis.LabelStyle>
                            <chart:ChartAxisLabelStyle TextColor="White" FontSize="10"/>
                        </chart:NumericalAxis.LabelStyle>
                    </chart:NumericalAxis>
                </chart:SfCartesianChart.YAxes>

                <chart:SfCartesianChart.Series>
                    <chart:AreaSeries TrackballLabelTemplate="{StaticResource ball}" ShowTrackballLabel="True" ItemsSource="{Binding DataForHeight}" XBindingPath="X" YBindingPath="Height" Fill="LightBlue" Stroke="Blue" StrokeWidth="3" Opacity="0.9" />
                    <chart:ScatterSeries ItemsSource="{Binding StartPoint}" XBindingPath="X" YBindingPath="Y" Type="Circle" PointWidth="15" PointHeight="15" Fill="#32CD32" Stroke="#32CD32"/>
                    <chart:ScatterSeries ItemsSource="{Binding EndPoint}" XBindingPath="X" YBindingPath="Y" Type="Circle" PointWidth="15" PointHeight="15"  Fill="Red" Stroke="Red"/>
                </chart:SfCartesianChart.Series>

                <chart:SfCartesianChart.TrackballBehavior>
                    <chart:ChartTrackballBehavior ShowLine="True" DisplayMode="NearestPoint">
                        <chart:ChartTrackballBehavior.LabelStyle>
                            <chart:ChartLabelStyle Background="Gold"/>
                        </chart:ChartTrackballBehavior.LabelStyle>
                        <chart:ChartTrackballBehavior.LineStyle>
                            <chart:ChartLineStyle Stroke="BlueViolet" StrokeWidth="3" StrokeDashArray="1"/>
                        </chart:ChartTrackballBehavior.LineStyle>
                        <chart:ChartTrackballBehavior.MarkerSettings>
                            <chart:ChartMarkerSettings Height="15" Width="15" Fill="Orange"/>
                        </chart:ChartTrackballBehavior.MarkerSettings>
                    </chart:ChartTrackballBehavior>
                </chart:SfCartesianChart.TrackballBehavior>

            </chart:SfCartesianChart>
            <Button Text="Back to Menu" Command="{Binding C_BackToMenu}" Margin="10"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>