<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DownhillApp.View.Measure"
             Title="The mountain is calling, and I must ride!">
    <VerticalStackLayout>
        <Button Text="Back to Menu" Command="{Binding C_BackToMenu}" Margin="10"/>
        <Button Text="Save this Ride" Command="{Binding C_SaveRide}" Margin="10,10,10,50"/>
        
        <Label Text="Name of the Ride" Margin="10,0,10,10"/>
        <Entry Text="{Binding Name}" Margin="10,0,10,20"/>
        <Grid ColumnDefinitions="*,*" RowDefinitions="*,*">
            <Label Text="Name Of the Track" Margin="10,0,10,10"/>
            <Picker Grid.Row="1" SelectedItem="{Binding SelectedGroup}" ItemsSource="{Binding AllGroup}" Margin="10,0,10,20"/>
            <Label Grid.Column="1" Text="Time:"/>
            <Label Grid.Column="1" Grid.Row="1" Text="{Binding RideTime}"/>
        </Grid>

        <Grid ColumnDefinitions="auto,auto,auto" Margin="10,0,10,20">
            <Label Text="New Track Name:" HorizontalOptions="End" VerticalOptions="Center" Margin="0,0,10,0"/>
            <Entry Text="{Binding GroupName}" Grid.Column="1" WidthRequest="150" Margin="0,0,10,0"/>
            <Button Text="Add new track" Grid.Column="2" Command="{Binding C_AddNewGroup}" MaximumWidthRequest="150" Background="DarkViolet"/>
        </Grid>

        <Grid ColumnDefinitions="*,*" Margin="10">
            <Button Text="Start Ride" Command="{Binding C_StartMeasure}" Margin="10" BackgroundColor="ForestGreen"/>
            <Button Text="Stop Ride" Command="{Binding C_StopMeasure}" Grid.Column="1" Margin="10" BackgroundColor="Firebrick"/>
        </Grid>
        <ScrollView MaximumHeightRequest="500">
            <CollectionView ItemsSource="{Binding AllMeasure}">

            </CollectionView>
        </ScrollView>
    </VerticalStackLayout>
</ContentPage>