<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DownhillApp.View.AllGroup"
             Title="All Groups">
    
    <VerticalStackLayout>
        <Grid ColumnDefinitions="* ,*" RowDefinitions="*,auto">
            <Label Text="Here you can see all the groups!" VerticalOptions="Center" HorizontalOptions="Center"/>
            <CollectionView Grid.Row="1" ItemsSource="{Binding AllGroupName}" SelectedItem="{Binding SelectedName}" SelectionMode="Single" Margin="10">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10">
                            <Border Stroke="White">
                                <Grid ColumnDefinitions="auto,*">
                                    <Label Text="Name:" VerticalOptions="Center" Margin="10,0"/>
                                    <Label Text="{Binding}" Grid.Column="1" VerticalOptions="Center" Margin="10"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout Grid.Column="1" Grid.Row="1">
                <Button Text="Modify" Command="{Binding C_Update}" BackgroundColor="Goldenrod" Margin="10" Padding="50,0"/>
                <Button Text="Delete" Command="{Binding C_Delete}" BackgroundColor="FireBrick" Margin="10" Padding="50,0"/>
                <Label Text="New Groupname or Modify the displayed one:" Margin="10,40,0,0"/>
                <Entry Text="{Binding EditName}" Margin="10"/>
                <Button Text="Save/Add" Command="{Binding C_Add}" BackgroundColor="ForestGreen" Margin="10"/>
                <Button Text="Back to Menu" Command="{Binding C_BacktoMenu}" Margin="10,50,0,0"/>
            </VerticalStackLayout>
            
        </Grid>
    </VerticalStackLayout>
</ContentPage>