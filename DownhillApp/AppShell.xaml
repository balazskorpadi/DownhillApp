<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="DownhillApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:DownhillApp"
    xmlns:view="clr-namespace:DownhillApp.View"
    Title="DownhillApp"
    FlyoutBehavior="Disabled">

    <ShellContent
        Title="MainMenu"
        ContentTemplate="{DataTemplate local:MainPage}"
        Route="MainPage" />

    <ShellContent
        Title="MeasurePage"
        ContentTemplate="{DataTemplate view:Measure}"
        Route="Measure"/>
    
    <ShellContent
        Title="ResultPage"
        ContentTemplate="{DataTemplate view:Result}"
        Route="Result"/>

    <ShellContent
        Title="AllGroupsPage"
        ContentTemplate="{DataTemplate view:AllGroup}"
        Route="AllGroups"/>
    
    <ShellContent
        Title="AnalisePage"
        ContentTemplate="{DataTemplate view:Analise}"
        Route="Analise"/>

</Shell>
