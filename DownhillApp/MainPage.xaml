<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DownhillApp.MainPage"
             Title="Downhill App Main Menu">
    <VerticalStackLayout>
        <Button Text="One more hill, one more thrill" Command="{Binding C_NewMeasure}" Margin="10"/>
        <Button Text="Conquer the hill, conquer yourself" Command="{Binding C_SeeResults}" Margin="10"/>
        <Button Text="See all Groups" Command="{Binding C_AllGroups}" Margin="10"/>
        <Button Text="See all Rides" Command="{Binding C_AllRides}" Margin="10"/>
    </VerticalStackLayout>
</ContentPage>
